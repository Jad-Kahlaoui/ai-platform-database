CREATE TABLE Utilisateur (
    email TEXT PRIMARY KEY,
    nom TEXT NOT NULL,
    motDePasse TEXT NOT NULL,
    dateInscription DATE NOT NULL CHECK (dateInscription <= CURRENT_DATE),
    qualiteGeneration TEXT CHECK (qualiteGeneration IN ('moyenne', 'haute')),
    horsLigneAutorise BOOLEAN,
    CHECK (
        (horsLigneAutorise = TRUE AND qualiteGeneration = 'haute') 
        OR horsLigneAutorise = FALSE
    )
);

CREATE TABLE Modele (
    nom TEXT PRIMARY KEY,
    description TEXT,
    dateCreation DATE NOT NULL CHECK (dateCreation <= CURRENT_DATE),
    longueurMax TEXT,
    resolution TEXT,
    duree TEXT,
    typeModele TEXT NOT NULL CHECK (typeModele IN ('texte', 'image', 'video')),
    CHECK (
        (typeModele = 'texte' AND longueurMax IS NOT NULL AND resolution IS NULL AND duree IS NULL)
        OR (typeModele = 'image' AND resolution IS NOT NULL AND longueurMax IS NULL AND duree IS NULL)
        OR (typeModele = 'video' AND duree IS NOT NULL AND longueurMax IS NULL AND resolution IS NULL)
    )
);

CREATE TABLE DonneeEntrainement (
    idDonnee SERIAL PRIMARY KEY,
    contenu TEXT NOT NULL,
    typeDonnee TEXT NOT NULL CHECK (typeDonnee IN ('texte', 'image', 'video')),
    dateAjout DATE NOT NULL CHECK (dateAjout <= CURRENT_DATE)
);

CREATE TABLE EntrainementModele (
    contenu INT REFERENCES DonneeEntrainement(idDonnee) ON DELETE CASCADE,
    nom TEXT REFERENCES Modele(nom) ON DELETE CASCADE,
    PRIMARY KEY (contenu, nom)
);

CREATE TABLE Resultat (
    idResultat INT PRIMARY KEY,
    email TEXT REFERENCES Utilisateur(email) ON DELETE CASCADE,
    nom TEXT REFERENCES Modele(nom) ON DELETE CASCADE,
    dateDebut DATE NOT NULL CHECK (dateDebut <= CURRENT_DATE)
);

CREATE TABLE MetaDonnee (
    idResultat INT REFERENCES Resultat(idResultat) ON DELETE CASCADE,
    cle TEXT NOT NULL,
    valeur TEXT,
    PRIMARY KEY (idResultat, cle)
);

CREATE TABLE Evaluation (
    email TEXT REFERENCES Utilisateur(email) ON DELETE CASCADE,
    idResultat INT REFERENCES Resultat(idResultat) ON DELETE CASCADE,
    date DATE NOT NULL CHECK (date <= CURRENT_DATE),
    note INT CHECK (note >= 0 AND note <= 5),
    commentaire TEXT,
    PRIMARY KEY (email, idResultat)
);

CREATE TABLE Collaboration (
    emailA TEXT REFERENCES Utilisateur(email) ON DELETE CASCADE,
    emailB TEXT REFERENCES Utilisateur(email) ON DELETE CASCADE,
    nom TEXT REFERENCES Modele(nom) ON DELETE CASCADE,
    dateDebut DATE NOT NULL,
    dateFin DATE NOT NULL,
    PRIMARY KEY (emailA, emailB, nom),
    CHECK (emailA <> emailB),
    CHECK (dateFin > dateDebut)
);

CREATE TABLE HistoriqueUtilisation (
    email TEXT REFERENCES Utilisateur(email) ON DELETE CASCADE,
    nom TEXT REFERENCES Modele(nom) ON DELETE CASCADE,
    date DATE NOT NULL CHECK (date <= CURRENT_DATE),
    typeInteraction TEXT NOT NULL CHECK (typeInteraction IN ('generation', 'consultation', 'entrainement', 'evaluation')),
    PRIMARY KEY (email, nom, date)
);

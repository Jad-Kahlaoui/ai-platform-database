Utilisateur(#email: TEXT, nom: TEXT, motDePasse: TEXT, dateInscription: DATE, typeUtilisateur: ENUM("regulier","premium"))
Premium(#email => Utilisateur, qualiteGeneration: TEXT, horsLigneAutorise: BOOL)
Modele(#nom: TEXT, description: TEXT, dateCreation: DATE, typeModele: ENUM("texte","image","video"))
LimiteTexte(#nom => Modele, longueurMax: TEXT)
LimiteImage(#nom => Modele, resolution: TEXT)
LimiteVideo(#nom => Modele, duree: TEXT)
DonneeEntrainement(#contenu: TEXT, typeDonnee: TEXT, dateAjout: DATE)
EntrainementModele(#contenu => DonneeEntrainement, #nom => Modele)
Resultat(#email => Utilisateur, #nom => Modele, #dateDebut: DATE)
MetaDonnee(#email => Utilisateur, #nom => Modele, #dateDebut => Resultat, #cle: TEXT, valeur: TEXT)
Evaluation(#idEvaluation: INT, email => Utilisateur, dateDebut => Resultat, note: INT, commentaire: TEXT, date: DATE)
Collaboration(#emailA => Utilisateur, #emailB => Utilisateur, #nom => Modele, dateDebut: DATE, dateFin: DATE)
HistoriqueUtilisation(#email => Utilisateur, #nom => Modele, #date: DATE, typeInteraction: TEXT)
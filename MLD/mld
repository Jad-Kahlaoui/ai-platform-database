Utilisateur(#email: TEXT, nom: TEXT, motDePasse: TEXT, dateInscription: DATE, qualiteGeneration: TEXT, horsLigneAutorise: BOOL)
Modele(#nom: TEXT, description: TEXT, dateCreation: DATE, TypeModele: TEXT ,longueurMax: TEXT, resolution: TEXT, duree: TEXT)
DonneeEntrainement(#contenu: TEXT, typeDonnee: TEXT, dateAjout: DATE)
EntrainementModele(#contenu => DonneeEntrainement, #nom => Modele)
Resultat(#idResultat: INT, email => Utilisateur, nom => Modele, dateDebut: DATE)
MetaDonnee(#idResultat => Resultat, #cle: TEXT, valeur: TEXT)
Evaluation(#email => Utilisateur, #idResultat => Resultat, date: DATE, note: INT, commentaire: TEXT)
Collaboration(#emailA => Utilisateur, #emailB => Utilisateur, #nom => Modele, dateDebut: DATE, dateFin: DATE)
HistoriqueUtilisation(#email => Utilisateur, #nom => Modele, #date: DATE, typeInteraction: TEXT)



** Contraintes Explicites  **

*Table Utilisateur :*
CHECK (dateInscription <= CURRENT_DATE),
CHECK (qualiteGeneration IN ('moyenne', 'haute')) 
horsLigneAutorise ne peut être TRUE que si l’utilisateur est premium
qualiteGeneration 'haute' que si Utilisateur est premium

*Table Modele* : 

 
CHECK (TypeModele IN ('texte', 'image', 'video')),


CHECK (

  if(TypeModele = 'texte') (longueurMax IS NOT NULL AND resolution IS NULL AND duree IS NULL)

  OR if(TypeModele = 'image') (resolution IS NOT NULL AND longueurMax IS NULL AND duree IS NULL)
  
  OR if(TypeModele = 'video') (duree IS NOT NULL AND longueurMax IS NULL AND resolution IS NULL)
)



CHECK (dateCreation <= CURRENT_DATE)

*Table DonneeEntrainement * :

CHECK (dateAjout <= CURRENT_DATE)
CHECK (typeDonnee IN ('texte', 'image', 'video')) 

* Table Resultat *:

CHECK (dateDebut <= CURRENT_DATE)

*Table MetaDonnee* :

Chaque clé doit être unique pour un même résultat.


*Table Evaluation* :

0 =< Evaluation.note <= 5
CHECK (date <= CURRENT_DATE)
Un utilisateur ne peut évaluer qu’un seul résultat donné une fois

*Table Collaboration* : 
Collaboration.emailA =! Collaboration.emailB
dateFin > dateDebut

Table HistoriqueUtilisation :
CHECK (typeInteraction IN ('generation', 'consultation', 'entrainement', 'evaluation')), 
CHECK (date <= CURRENT_DATE)

